// CodeCritic - Prisma Schema
// Matches the ER diagram: User, Submission, ReviewCriteria, Review, CriteriaRating

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------
// Enums
// -----------------------------

enum SubmissionStatus {
  Pending
  Reviewed
}

// -----------------------------
// Models
// -----------------------------

model User {
  id         Int      @id @default(autoincrement())
  clerkId    String   @unique
  username   String   @unique
  bio        String?
  techStack  String[]
  githubLink String?
  karma      Int      @default(0)
  createdAt  DateTime @default(now())

  // Relations
  submissions Submission[] 
  reviews     Review[]     
}

model Submission {
  id            Int              @id @default(autoincrement())
  userId        Int
  title         String
  description   String
  githubUrl     String
  techTags      String[]
  codeSnippet   String?
  codeLanguage  String?
  status        SubmissionStatus @default(Pending)
  createdAt     DateTime         @default(now())

  // Relations
  user     User             @relation(fields: [userId], references: [id])
  criteria ReviewCriteria[] 
  reviews  Review[]         

  @@index([userId])
}

model ReviewCriteria {
  id           Int    @id @default(autoincrement())
  submissionId Int
  label        String
  order        Int?

  // Relations
  submission Submission       @relation(fields: [submissionId], references: [id])
  ratings    CriteriaRating[] // ratings given against this criterion across reviews

  @@index([submissionId])
}

model Review {
  id            Int      @id @default(autoincrement())
  submissionId  Int
  reviewerId    Int
  strengths     String
  improvements  String
  resourceLinks String[]
  createdAt     DateTime @default(now())

  // Relations
  submission Submission       @relation(fields: [submissionId], references: [id])
  reviewer   User             @relation(fields: [reviewerId], references: [id])
  ratings    CriteriaRating[] 

  @@index([submissionId])
  @@index([reviewerId])
}

model CriteriaRating {
  id         Int @id @default(autoincrement())
  reviewId   Int
  criteriaId Int
  rating     Int 

  // Relations
  review   Review         @relation(fields: [reviewId], references: [id])
  criteria ReviewCriteria @relation(fields: [criteriaId], references: [id])

  @@index([reviewId])
  @@index([criteriaId])
}
