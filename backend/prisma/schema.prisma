// CodeCritic - Prisma Schema
// Matches the ER diagram: User, Submission, ReviewCriteria, Review, CriteriaRating

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------
// Enums
// -----------------------------

enum SubmissionStatus {
  Pending
  Reviewed
}

// -----------------------------
// Models
// -----------------------------

model User {
  id          Int          @id @default(autoincrement())
  clerkId     String       @unique
  username    String       @unique
  bio         String?
  techStack   String[]
  githubLink  String?
  karma       Int          @default(0)
  createdAt   DateTime     @default(now())
  reviews     Review[]
  submissions Submission[]
}

model Submission {
  id           Int              @id @default(autoincrement())
  userId       Int
  title        String
  description  String
  githubUrl    String
  techTags     String[]
  status       SubmissionStatus @default(Pending)
  createdAt    DateTime         @default(now())
  codeLanguage String?
  codeSnippet  String?
  reviews      Review[]
  criteria     ReviewCriteria[]
  user         User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ReviewCriteria {
  id           Int              @id @default(autoincrement())
  submissionId Int
  label        String
  order        Int?
  ratings      CriteriaRating[]
  submission   Submission       @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

model Review {
  id            Int              @id @default(autoincrement())
  submissionId  Int
  reviewerId    Int
  strengths     String
  improvements  String
  resourceLinks String[]
  createdAt     DateTime         @default(now())
  ratings       CriteriaRating[]
  reviewer      User             @relation(fields: [reviewerId], references: [id])
  submission    Submission       @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
  @@index([reviewerId])
}

model CriteriaRating {
  id         Int            @id @default(autoincrement())
  reviewId   Int
  criteriaId Int
  rating     Int
  criteria   ReviewCriteria @relation(fields: [criteriaId], references: [id])
  review     Review         @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@index([criteriaId])
}

enum SubmissionStatus {
  Pending
  Reviewed
}
